# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / UI build
node_modules/
ui/dist/

# Generated from the Python contracts by `npm run gen:types`. Committing these
# would let a stale copy disagree with the backend without anything failing.
ui/src/generated/
ui/openapi.json

# Third-party sensor library, fetched by scripts/fetch-sensors.ps1 (MPL-2.0, not vendored)
vendor/

# PyInstaller output. warden.spec is committed; the 45 MB it produces is not.
build/
dist/

# Bundled model runtime: ollama.exe plus ~1 GB of weights, staged by
# scripts/fetch-model.ps1. Third-party binaries do not belong in the history.
runtime/

# Runtime state: recorded sessions from live runs. fixtures/ IS committed; sessions/ is not.
sessions/

# Local, machine-specific overrides. Never contains credentials by design.
warden.local.toml

# User preferences. Written beside the sessions when frozen; from a source
# checkout data_path() resolves into the repo, so it lands here instead.
settings.json

# The Groq API key, if the user has enabled the cloud model. Named explicitly
# rather than relying on the settings.json rule above, even though data_path()
# puts both in the same place: this repository is public, and a secret must not
# depend on a line written for something else still happening to cover it.
credentials.json

# OS
Thumbs.db
desktop.ini

# Internal brief for the team, written against a specific build. Deliberately
# not published: it contains presentation notes and candid limitations meant
# for us rather than for anyone evaluating the product.
WARDEN-TEAM-BRIEF.txt
WARDEN-PITCH.txt

# Round-two slide content, written against a specific build.
WARDEN-DECK.md
